@@ -493,7 +493,7 @@
                  const struct pipe_blit_info *blit_info)
 {
    void *smap, *srow, *dmap, *drow;
-   size_t tile_size;
+   size_t tile_row_bytes;
 
    assert(src->layout == ETNA_LAYOUT_TILED);
