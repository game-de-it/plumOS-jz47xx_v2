-template<typename T, int alpha_shift>
-static void BlitStraight(const MDFN_Surface *src_surface, const MDFN_Rect *src_rect, MDFN_Surface *dest_surface, const MDFN_Rect *dest_rect)
+/* Respect both surface pitches and the active source rectangle. */
+void MDFN_StretchBlitSurface(const MDFN_Surface* src, const MDFN_Rect& sr,
+ MDFN_Surface* dst, const MDFN_Rect& dr, bool source_alpha, int scanlines,
+ const MDFN_Rect* original_src_rect, int rotated, int InterlaceField)
