 }
 
+#ifdef PLUMOS_MULTIMODEL
+static const char *const model_kernels[] = {
+	"RG280V  BIN", "RG300X  BIN", "RG350   BIN", "RG350M  BIN",
+};
+
+const char *select_boot_kernel(const char *saved)
+{
+	const unsigned int directions = BIT(21) | BIT(24) | BIT(25) | BIT(23);
+	unsigned int pressed, idle_samples = 0;
+	const char *previous = NULL;
+
+	if (saved) {
+		for (unsigned int i = 0; i < ARRAY_SIZE(model_kernels); i++) {
+			if (!strncmp(saved, model_kernels[i], 11)) {
+				previous = model_kernels[i];
+				break;
+			}
+		}
+	}
+
+	/* The four handhelds share the same active-low D-pad wiring. */
+	__gpio_as_input_mask(GPIOE, directions);
+	__gpio_enable_pull_mask(GPIOE, directions);
+	SERIAL_PUTS("Choose model with D-pad: UP RG280V, RIGHT RG300X, "
+		   "DOWN RG350, LEFT RG350M.\n");
+
+	for (;;) {
+		pressed = ~REG32(GPIO_PXPIN(GPIOE)) & directions;
+		udelay(20000);
+		if (pressed != (~REG32(GPIO_PXPIN(GPIOE)) & directions)) {
+			idle_samples = 0;
+			continue;
+		}
+
+		switch (pressed) {
+		case BIT(21): return model_kernels[0];
+		case BIT(24): return model_kernels[1];
+		case BIT(25): return model_kernels[2];
+		case BIT(23): return model_kernels[3];
+		case 0:
+			/* Give an override time to settle before using the SD preference. */
+			if (previous && ++idle_samples == 6)
+				return previous;
+			break;
+		default:
+			idle_samples = 0;
+			break;
+		}
+	}
+}
+#endif
