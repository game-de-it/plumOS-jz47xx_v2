+#ifdef PLUMOS_MULTIMODEL
+static const char *choose_kernel(unsigned int id, struct dir_entry *start,
+				 struct dir_entry *end)
+{
+	uint32_t sector[FAT_BLOCK_SIZE >> 2];
+	const char *saved = (const char *)sector;
+	struct dir_entry *entry = find_file(start, end, "BOOTMOD CFG");
+
+	/* BOOTMOD.CFG holds the padded 8.3 kernel name followed by a newline. */
+	if (entry && entry->size == 12) {
+		uint32_t cluster = entry->starthi << 16 | entry->start;
+
+		if (cluster >= 2 && cluster < 0x0ffffff0 &&
+		    !mmc_block_read(id, sector, lba_data + (cluster - 2) * cluster_size, 1) &&
+		    saved[11] == '\n')
+			return select_boot_kernel(saved);
+	}
+	return select_boot_kernel(NULL);
+}
+#endif
