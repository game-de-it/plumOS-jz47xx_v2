+unsigned char cpc6128_bin[32768];
+static unsigned char romdisc_bin[16384];
+
+static int read_firmware(const char *directory, const char *name,
+                         unsigned char *image, size_t size)
+{
+    char path[4096];
+    int length = snprintf(path, sizeof(path), "%s/%s", directory, name);
+    if (length < 0 || (size_t)length >= sizeof(path)) {
+        fprintf(stderr, "CrocoDS: firmware path is too long\n");
+        return 0;
+    }
+    FILE *file = fopen(path, "rb");
+    if (!file) {
+        fprintf(stderr, "CrocoDS: missing firmware %s (%zu bytes)\n", path, size);
+        return 0;
+    }
+    int valid = fread(image, 1, size, file) == size &&
+                fgetc(file) == EOF && !ferror(file);
+    fclose(file);
+    if (!valid)
+        fprintf(stderr, "CrocoDS: invalid firmware %s (expected %zu bytes)\n", path, size);
+    return valid;
+}
+
+int CrocoDSLoadFirmware(const char *directory)
+{
+    return read_firmware(directory, "cpc6128.rom", cpc6128_bin, sizeof(cpc6128_bin)) &&
+           read_firmware(directory, "amsdos.rom", romdisc_bin, sizeof(romdisc_bin));
+}
 
