diff --git a/src/sdl-dingux/sdl_audio.cpp b/src/sdl-dingux/sdl_audio.cpp
index 860ea01..1d5e10b 100644
--- a/src/sdl-dingux/sdl_audio.cpp
+++ b/src/sdl-dingux/sdl_audio.cpp
@@ -41,0 +42 @@ static int buffered_bytes=0;
+static int audio_stalled=0;
@@ -45,0 +47,4 @@ static int sdl_write_buffer_m(unsigned char* data, int len)
+	if (audio_stalled) {
+		SDL_UnlockMutex(sound_mutex);
+		return len;
+	}
@@ -60 +65,13 @@ static int sdl_write_buffer_m(unsigned char* data, int len)
-		while(buffered_bytes == BUFFSIZE) SDL_CondWait(sound_cv, sound_mutex);
+		if (buffered_bytes == BUFFSIZE) {
+			/* A failed ALSA writer can stop SDL's callback permanently.
+			 * Do not freeze emulation while waiting for an audio consumer. */
+			SDL_CondWaitTimeout(sound_cv, sound_mutex, 30);
+			if (buffered_bytes == BUFFSIZE) {
+				fprintf(stderr, "FBA audio callback stalled; dropping audio until it resumes\n");
+				audio_stalled = 1;
+				buffered_bytes = 0;
+				buf_read_pos = buf_write_pos;
+				SDL_UnlockMutex(sound_mutex);
+				return len;
+			}
+		}
@@ -106,0 +124 @@ void sdl_callback_m(void *unused, Uint8 *stream, int len)
+	audio_stalled = 0;
@@ -107,0 +126 @@ void sdl_callback_m(void *unused, Uint8 *stream, int len)
+	memset(stream, 0, len);
@@ -115,0 +135 @@ void sdl_callback(void *unused, Uint8 *stream, int len)
+	memset(stream, 0, len);
@@ -142,0 +163 @@ static int sdl_open_common(int rate, int channels, int format, int mutex)
+	audio_stalled = 0;
diff --git a/src/sdl-dingux/sdl_input.cpp b/src/sdl-dingux/sdl_input.cpp
index 3a1ca5f..c63170b 100644
--- a/src/sdl-dingux/sdl_input.cpp
+++ b/src/sdl-dingux/sdl_input.cpp
@@ -20,0 +21 @@
+#include <stdio.h>
@@ -229,0 +231,14 @@ void do_keypad()
+	// RG280V has no dedicated menu button. Reserve SELECT+START for the
+	// emulator menu, as on the other plumOS emulators.
+	if ((keypc & (BUTTON_SELECT | BUTTON_START)) == (BUTTON_SELECT | BUTTON_START)) {
+		keypc = keypad = 0;
+		fprintf(stderr, "FBA menu: pausing audio\n");
+		SndPause(1);
+		fprintf(stderr, "FBA menu: opening\n");
+		gui_Run();
+		fprintf(stderr, "FBA menu: resuming audio\n");
+		SndPause(0);
+		fprintf(stderr, "FBA menu: returned to game\n");
+		return;
+	}
+
@@ -319 +333,0 @@ void do_keypad()
-	else if ((keypc & BUTTON_START) && (keypc & BUTTON_SELECT)) P1P2Start = 1;
diff --git a/src/sdl-dingux/sdl_menu.cpp b/src/sdl-dingux/sdl_menu.cpp
index abef65e..fed2ddd 100644
--- a/src/sdl-dingux/sdl_menu.cpp
+++ b/src/sdl-dingux/sdl_menu.cpp
@@ -607,0 +608 @@ void gui_Run()
+	fprintf(stderr, "FBA menu: selection closed\n");
@@ -609,0 +611 @@ void gui_Run()
