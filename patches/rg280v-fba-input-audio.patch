diff --git a/src/sdl-dingux/alsa_audio.cpp b/src/sdl-dingux/alsa_audio.cpp
new file mode 100644
index 0000000..625bcb9
--- /dev/null
+++ b/src/sdl-dingux/alsa_audio.cpp
@@ -0,0 +1,87 @@
+#include <alsa/asoundlib.h>
+#include <errno.h>
+#include <stdio.h>
+#include <time.h>
+
+#include "alsa_audio.h"
+
+static snd_pcm_t *pcm;
+static unsigned int sample_rate;
+static unsigned int channel_count;
+static time_t next_open_attempt;
+
+static int open_pcm(void)
+{
+	int rc = snd_pcm_open(&pcm, "default", SND_PCM_STREAM_PLAYBACK, SND_PCM_NONBLOCK);
+	if (rc < 0) {
+		fprintf(stderr, "FBA ALSA open failed: %s\n", snd_strerror(rc));
+		pcm = NULL;
+		return 0;
+	}
+	rc = snd_pcm_set_params(pcm, SND_PCM_FORMAT_S16_LE,
+		SND_PCM_ACCESS_RW_INTERLEAVED, channel_count, sample_rate, 1, 120000);
+	if (rc < 0) {
+		fprintf(stderr, "FBA ALSA parameters failed: %s\n", snd_strerror(rc));
+		snd_pcm_close(pcm);
+		pcm = NULL;
+		return 0;
+	}
+	fprintf(stderr, "FBA ALSA ready: %u Hz, %u channels\n", sample_rate, channel_count);
+	return 1;
+}
+
+int alsa_open(int rate, int channels, int format)
+{
+	if (format != 16 || rate <= 0 || channels <= 0) return 0;
+	sample_rate = rate;
+	channel_count = channels;
+	next_open_attempt = 0;
+	return open_pcm();
+}
+
+void alsa_close(void)
+{
+	if (pcm) {
+		snd_pcm_close(pcm);
+		pcm = NULL;
+	}
+}
+
+void alsa_pause(int pause)
+{
+	if (!pcm) return;
+	int rc = pause ? snd_pcm_drop(pcm) : snd_pcm_prepare(pcm);
+	if (rc < 0) {
+		fprintf(stderr, "FBA ALSA menu transition failed: %s\n", snd_strerror(rc));
+		alsa_close();
+	}
+}
+
+int alsa_play(unsigned char *data, int len)
+{
+	if (!pcm) {
+		time_t now = time(NULL);
+		if (now < next_open_attempt) return len;
+		next_open_attempt = now + 1;
+		if (!open_pcm()) return len;
+	}
+	const int bytes_per_frame = channel_count * 2;
+	if (bytes_per_frame <= 0 || len < bytes_per_frame) return len;
+	snd_pcm_sframes_t frames = len / bytes_per_frame;
+	snd_pcm_sframes_t written = snd_pcm_writei(pcm, data, frames);
+	if (written == -EAGAIN) return len;
+	if (written < 0) {
+		int rc = snd_pcm_recover(pcm, written, 1);
+		if (rc < 0) {
+			fprintf(stderr, "FBA ALSA write failed: %s\n", snd_strerror(rc));
+			alsa_close();
+			return len;
+		}
+		written = snd_pcm_writei(pcm, data, frames);
+		if (written < 0 && written != -EAGAIN) {
+			fprintf(stderr, "FBA ALSA retry failed: %s\n", snd_strerror(written));
+			alsa_close();
+		}
+	}
+	return len;
+}
