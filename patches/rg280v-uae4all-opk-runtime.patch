+#if defined(GCW0) && defined(NO_THREADS)
+void plumos_frame_pace(unsigned hz)
+{
+    static unsigned remainder;
+    if (!hz) hz = VBLANK_HZ_PAL;
+    proximo_frameskip += 1000 / hz;
+    remainder += 1000 % hz;
+    if (remainder >= hz) { ++proximo_frameskip; remainder -= hz; }
+    Sint32 ahead = (Sint32)(proximo_frameskip - SDL_GetTicks());
+    if (ahead > 0 && ahead < 100) SDL_Delay(ahead);
+    else if (ahead <= -100 || ahead >= 100) proximo_frameskip = SDL_GetTicks();
+}
+#endif
+
 
