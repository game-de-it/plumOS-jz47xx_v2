+// Keep source images intact: list and grid views can request different sizes.
+Surface *SurfaceCollection::fitIcon(const std::string &path, int width, int height) {
+    if (width < 1 || height < 1) return NULL;
+    const std::string key = path + "::fit:" + std::to_string(width) + "x" + std::to_string(height);
+    SurfaceHash::iterator cached = surfaces.find(key);
+    if (cached != surfaces.end()) return cached->second;
+    Surface *source = addIcon(path);
+    if (!source || !source->raw) return NULL;
+    if (source->raw->w <= width && source->raw->h <= height) return source;
+    const double scale = std::min(double(width) / source->raw->w,
+                                  double(height) / source->raw->h);
+    SDL_Surface *scaled = zoomSurface(source->raw, scale, scale, SMOOTHING_ON);
+    if (!scaled) return NULL;
+    Surface *result = new Surface();
+    result->raw = scaled;
+    surfaces[key] = result;
+    return result;
+}
+
+Surface *SurfaceCollection::themedIcon(const std::string &path, bool selected, int width, int height) {
+    const std::string key = path + (selected ? "#selected" : "#normal");
+    auto found = themedPaths.find(key);
+    if (found == themedPaths.end()) {
+        std::string name = FileUtils::pathBaseName(path);
+        std::string themed;
+        if (selected && name.size() > 4)
+            themed = skin->getSkinFilePath("systems/" + name.substr(0, name.size()-4) + "-selected.png");
+        if (themed.empty()) themed = skin->getSkinFilePath("systems/" + name);
+        if (themed.empty()) themed = path;
+        found = themedPaths.insert(std::make_pair(key, themed)).first;
+    }
+    return fitIcon(found->second, width, height);
+}
