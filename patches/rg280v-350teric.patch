+// Shared geometry and live status for the optional instrument-style skin.
+void UI::drawInstrumentHeader(Surface *s, std::string title) {
+    const int width = app->getScreenWidth();
+    static uint32_t lastPowerRead = 0;
+    const uint32_t now = SDL_GetTicks();
+    if (now - lastPowerRead >= 2000) {
+        app->hw->Power()->read();
+        lastPowerRead = now;
+    }
+    const RGBAColor clear = {0,0,0,0};
+    const auto dash = title.find(" - ");
+    if (dash != std::string::npos) title = title.substr(0, dash);
+    for (char &c : title) if (c >= 'a' && c <= 'z') c -= 'a' - 'A';
+    while (!title.empty() && app->fontTitle->getTextWidth(title) > width - 140) {
+        // Drop a whole UTF-8 codepoint when shortening a dialog title.
+        size_t pos = title.size() - 1;
+        while (pos > 0 && (static_cast<unsigned char>(title[pos]) & 0xc0) == 0x80) --pos;
+        title.erase(pos);
+    }
+    s->box(5, 5, width - 10, 24, app->skin->colours.titleBarBackground);
+    s->box(5, 29, width - 10, 1, app->skin->accent);
+    if (app->skin->showClock)
+        s->write(app->fontSectionTitle, app->hw->Clock()->getClockTime(true),
+                 12, 17, VAlignMiddle, app->skin->colours.font, clear);
+    s->write(app->fontTitle, title, width / 2, 17,
+             HAlignCenter | VAlignMiddle, app->skin->accent, clear);
+    const bool charging = app->hw->Power()->state() == IPower::CHARGING;
+    const std::string battery = std::string(charging ? "CHG " : "BAT ") +
+                                (app->hw->Power()->state() == IPower::UNKNOWN ? "--" :
+                                 std::to_string(app->hw->Power()->rawLevel()));
+    s->write(app->fontSectionTitle, battery, width - 12, 17,
+             HAlignRight | VAlignMiddle, app->skin->colours.font, clear);
+}
+
+void UI::drawInstrumentFooter(Surface *s, const std::string &text) {
+    const int width = app->getScreenWidth(), height = app->getScreenHeight();
+    s->box(5, height - 22, width - 10, 17, app->skin->colours.infoBarBackground);
+    s->box(5, height - 22, width - 10, 1, (RGBAColor){80,85,88,255});
+    s->write(app->fontSectionTitle, text, width / 2, height - 13,
+             HAlignCenter | VAlignMiddle, app->skin->colours.font, (RGBAColor){0,0,0,0});
+}
+
+void UI::drawInstrumentSelection(Surface *s, SDL_Rect rect) {
+    s->box(rect, app->skin->colours.selectionBackground);
+    s->box(rect.x, rect.y + 2, 2, rect.h - 4, app->skin->accent);
+}
