+    if (!FileUtils::fileExists(BATTERY_LEVEL_PATH)) {
+        // Match the plumOS FE fallback on kernels exposing voltage but no capacity.
+        long voltage = 0, minimum = 3400000, maximum = 4200000;
+        std::ifstream now("/sys/class/power_supply/jz-battery/voltage_now");
+        if (!(now >> voltage)) return false;
+        std::ifstream low("/sys/class/power_supply/jz-battery/voltage_min_design");
+        std::ifstream high("/sys/class/power_supply/jz-battery/voltage_max_design");
+        long value;
+        if (low >> value) minimum = value;
+        if (high >> value) maximum = value;
+        if (maximum <= minimum) return false;
+        long percent = (voltage - minimum) * 100 / (maximum - minimum);
+        level_ = percent < 0 ? 0 : (percent > 100 ? 100 : percent);
+        return true;
