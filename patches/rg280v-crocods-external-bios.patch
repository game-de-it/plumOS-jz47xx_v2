+static int load_memory_chunk(u8 *ram, size_t bank_size, const u8 *data, size_t size)
+{
+    size_t offset = 0;
+    while (size != 0) {
+        u8 value = *data++;
+        size--;
+        size_t count = 1;
+        if (value == 0xe5) {
+            if (size == 0)
+                return 0;
+            count = *data++;
+            size--;
+            if (count == 0) {
+                count = 1;
+            } else {
+                if (size == 0)
+                    return 0;
+                value = *data++;
+                size--;
+            }
+        }
+        if (count > bank_size - offset)
+            return 0;
+        memset(ram + offset, value, count);
+        offset += count;
+    }
+    return offset == bank_size;
+}
