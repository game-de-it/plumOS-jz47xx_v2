diff --git a/src/sdl/input.c b/src/sdl/input.c
index 1df8818..ede315e 100644
--- a/src/sdl/input.c
+++ b/src/sdl/input.c
@@ -70,5 +70,6 @@ int PLATFORM_kbd_joy_1_enabled = FALSE;	/* disabled, would steal normal keys */
-static int KBD_TRIG_0 = SDLK_RCTRL;
-static int KBD_STICK_0_LEFT = SDLK_KP4;
-static int KBD_STICK_0_RIGHT = SDLK_KP6;
-static int KBD_STICK_0_DOWN = SDLK_KP5;
-static int KBD_STICK_0_UP = SDLK_KP8;
+/* RG280V's SDL keymap reports the physical D-pad and A this way. */
+static int KBD_TRIG_0 = SDLK_LCTRL;
+static int KBD_STICK_0_LEFT = SDLK_LEFT;
+static int KBD_STICK_0_RIGHT = SDLK_RIGHT;
+static int KBD_STICK_0_DOWN = SDLK_DOWN;
+static int KBD_STICK_0_UP = SDLK_UP;
@@ -341,0 +343 @@ int PLATFORM_Keyboard(void)
+	static int menu_chord_latched = FALSE;
@@ -676,0 +679,2 @@ int PLATFORM_Keyboard(void)
+	if (kbhits[SDLK_ESCAPE] && !UI_is_active)
+		INPUT_key_consol &= ~INPUT_CONSOL_SELECT;
@@ -678,0 +683,12 @@ int PLATFORM_Keyboard(void)
+	if (kbhits[SDLK_RETURN])
+		INPUT_key_consol &= ~INPUT_CONSOL_START;
+
+	/* RG280V: reserve physical SELECT+START for the emulator menu. */
+	if (!kbhits[SDLK_ESCAPE] || !kbhits[SDLK_RETURN])
+		menu_chord_latched = FALSE;
+	else if (!menu_chord_latched && !UI_is_active) {
+		menu_chord_latched = TRUE;
+		key_pressed = 0;
+		INPUT_key_consol = INPUT_CONSOL_NONE;
+		return AKEY_UI;
+	}
@@ -707,0 +724,4 @@ int PLATFORM_Keyboard(void)
+	if (UI_is_active && lastkey == SDLK_LCTRL)
+		return AKEY_RETURN;
+	if (UI_is_active && lastkey == SDLK_LALT)
+		return AKEY_ESCAPE;
diff --git a/src/sdl/video.c b/src/sdl/video.c
index ff075d4..a483736 100644
--- a/src/sdl/video.c
+++ b/src/sdl/video.c
@@ -244,0 +245,9 @@ VIDEOMODE_resolution_t *PLATFORM_AvailableResolutions(unsigned int *size)
+#ifdef PLUMOS_RG280V
+	/* The panel is 320x480, but SDL's 320x240 mode uses its correct
+	 * vertical scaling. Atari800's 320x480 mode letterboxes to half height. */
+	VIDEOMODE_resolution_t *resolutions = Util_malloc(sizeof(*resolutions));
+	resolutions[0].width = 320;
+	resolutions[0].height = 240;
+	*size = 1;
+	return resolutions;
+#else
@@ -268,0 +278 @@ VIDEOMODE_resolution_t *PLATFORM_AvailableResolutions(unsigned int *size)
+#endif
diff --git a/src/videomode.c b/src/videomode.c
index 9a6b627..e3a8693 100644
--- a/src/videomode.c
+++ b/src/videomode.c
@@ -1201,0 +1202,6 @@ int VIDEOMODE_InitialiseDisplay(void)
+#ifdef PLUMOS_RG280V
+	/* Override settings read from the shared home directory on this device. */
+	VIDEOMODE_windowed = FALSE;
+	init_fs_resolution.width = 320;
+	init_fs_resolution.height = 240;
+#endif
