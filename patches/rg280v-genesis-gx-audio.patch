diff --git a/gcw0/main.c b/gcw0/main.c
index 5724ce0..4aad686 100644
--- a/gcw0/main.c
+++ b/gcw0/main.c
@@ -81,18 +81,10 @@ static void sdl_sound_callback(void *userdata, Uint8 *stream, int len)
-    if(sdl_sound.current_emulated_samples < len)
-    {
-        memset(stream, 0, len);
-    }
-    else
-    {
-        memcpy(stream, sdl_sound.buffer, len);
-        /* loop to compensate desync */
-        do
-        {
-            sdl_sound.current_emulated_samples -= len;
-        }
-        while(sdl_sound.current_emulated_samples > 2 * len);
-        memcpy(sdl_sound.buffer,
-               sdl_sound.current_pos - sdl_sound.current_emulated_samples,
-               sdl_sound.current_emulated_samples);
-        sdl_sound.current_pos = sdl_sound.buffer + sdl_sound.current_emulated_samples;
-    }
+ int used = sdl_sound.current_emulated_samples;
+ int count = used < len ? used : len;
+ memset(stream, 0, len);
+ if (count) {
+  memcpy(stream, sdl_sound.buffer, count);
+  used -= count;
+  memmove(sdl_sound.buffer, sdl_sound.buffer + count, used);
+  sdl_sound.current_emulated_samples = used;
+  sdl_sound.current_pos = sdl_sound.buffer + used;
+ }
