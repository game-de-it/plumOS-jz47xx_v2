+ int frames = audio_update(soundframe);
+ if (!enabled) return;
+ if (!plum_pcm) {
+  Uint32 now = SDL_GetTicks();
+  if ((int)(now - plum_retry) < 0) return;
+  plum_retry = now + 1000;
+  if (!sdl_sound_init()) return;
+ }
+ static unsigned int calls, missed, recovered;
+ static Uint32 since;
+ if (!since) since = SDL_GetTicks();
+ snd_pcm_sframes_t written = snd_pcm_writei(plum_pcm, soundframe, frames);
+ if (written < 0) missed += frames;
+ else if (written < frames) missed += frames - written;
+ if (++calls == 300) {
+  fprintf(stderr, "Genesis ALSA frames=300 elapsed_ms=%u missed_samples=%u recoveries=%u\n",
+    SDL_GetTicks() - since, missed, recovered);
+  calls = missed = recovered = 0;
+  since = SDL_GetTicks();
+ }
+ if (written < 0 && written != -EAGAIN) {
+  recovered++;
+  int rc = snd_pcm_recover(plum_pcm, written, 1);
+  if (rc < 0) {
+   fprintf(stderr, "Genesis ALSA write: %s\n", snd_strerror(rc));
+   sdl_sound_close();
+  }
+ }
