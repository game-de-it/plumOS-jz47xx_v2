From: plumOS RG280V port <noreply@plumos.local>
Subject: [PATCH] MIPS: ingenic: RG280V: wake on power-key assertion

The RG280V power key is active low. Select the press edge explicitly for
system wake instead of relying on the JZ4770 GPIO controller's emulated
both-edge trigger while the system is suspended.

---
 arch/mips/boot/dts/ingenic/rg280v.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/mips/boot/dts/ingenic/rg280v.dts b/arch/mips/boot/dts/ingenic/rg280v.dts
--- a/arch/mips/boot/dts/ingenic/rg280v.dts
+++ b/arch/mips/boot/dts/ingenic/rg280v.dts
@@ -2,6 +2,7 @@
 /dts-v1/;
 
 #include "bits/gcw0-base.dtsi"
+#include <dt-bindings/input/gpio-keys.h>
 
 / {
 	compatible = "ylm,rg280v", "ingenic,jz4770";
@@ -14,6 +15,10 @@
 	};
 };
 
+&btn12 {
+	wakeup-event-action = <EV_ACT_ASSERTED>;
+};
+
 &joystick {
 	status = "disabled";
 };
