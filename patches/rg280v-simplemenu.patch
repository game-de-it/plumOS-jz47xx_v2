 #include <SDL/SDL_events.h>
 #include <SDL/SDL_keyboard.h>
 
 #include "../headers/globals.h"
 
+#ifdef PLUMOS_RG280V
+/* SDL_GetKeyState reflects the end of a pumped batch, not each queued event. */
+static Uint8 plumosHeld[SDLK_LAST];
+static Uint8 plumosActionKeys[SDLK_LAST];
+static SDLKey plumosRepeatKey = SDLK_UNKNOWN;
+static Uint32 plumosRepeatAt;
+static int plumosDirection(SDLKey key) {
+    return key==BTN_UP || key==BTN_DOWN || key==BTN_LEFT || key==BTN_RIGHT;
+}
+static void plumosClearInput(void) {
+    memset(plumosHeld,0,sizeof(plumosHeld));
+    memset(plumosActionKeys,0,sizeof(plumosActionKeys));
+    plumosRepeatKey=SDLK_UNKNOWN;
+    plumosRepeatAt=0;
+}
+static void plumosPrepareAction(SDLKey key) {
+    memset(plumosActionKeys,0,sizeof(plumosActionKeys));
+    plumosActionKeys[key]=1;
+    /* B is SimpleMenu's explicit modifier for native button combinations. */
+    if (key!=BTN_B) plumosActionKeys[BTN_B]=plumosHeld[BTN_B];
+}
+int plumosPollEvent(SDL_Event *out) {
+    while (SDL_PollEvent(out)) {
+        if (out->type==SDL_KEYDOWN || out->type==SDL_KEYUP) {
+            SDLKey key=out->key.keysym.sym;
+            if (key<=SDLK_UNKNOWN || key>=SDLK_LAST) continue;
+            if (out->type==SDL_KEYDOWN) {
+                /* Ignore duplicate kernel/SDL repeats; the timer below owns repeat. */
+                if (plumosHeld[key]) continue;
+                plumosHeld[key]=1;
+                plumosPrepareAction(key);
+                if (plumosDirection(key)) {
+                    plumosRepeatKey=key;
+                    plumosRepeatAt=SDL_GetTicks()+250;
+                }
+            } else {
+                if (!plumosHeld[key]) continue;
+                plumosHeld[key]=0;
+                memset(plumosActionKeys,0,sizeof(plumosActionKeys));
+                if (plumosRepeatKey==key) plumosRepeatKey=SDLK_UNKNOWN;
+            }
+        } else if (out->type==SDL_ACTIVEEVENT && !out->active.gain) {
+            plumosClearInput();
+        }
+        return 1;
+    }
+    if (plumosRepeatKey!=SDLK_UNKNOWN && plumosHeld[plumosRepeatKey] &&
+        (Sint32)(SDL_GetTicks()-plumosRepeatAt)>=0) {
+        SDLKey key=plumosRepeatKey;
+        /* At most one repeat per pass; never catch up after a slow redraw. */
+        plumosRepeatAt=SDL_GetTicks()+80;
+        plumosPrepareAction(key);
+        memset(out,0,sizeof(*out));
+        out->type=SDL_KEYDOWN;
+        out->key.state=SDL_PRESSED;
+        out->key.keysym.sym=key;
+        return 1;
+    }
+    return 0;
+}
+#endif
