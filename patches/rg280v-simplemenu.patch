diff --git a/simplemenu/src/logic/bitmap_font.c b/simplemenu/src/logic/bitmap_font.c
new file mode 100644
index 0000000..dfceb8d
--- /dev/null
+++ b/simplemenu/src/logic/bitmap_font.c
@@ -0,0 +1,145 @@
+/* BDF integer-pixel renderer. DWIDTH/BBX offsets share the font's baseline. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "../headers/bitmap_font.h"
+
+typedef struct {
+    int code,advance,w,h,x,y,order;
+    Uint32 rows[32];
+} BitmapGlyph;
+struct BitmapFont {
+    int count,height,ascent;
+    BitmapGlyph *glyphs;
+};
+
+static int compare(const void *a,const void *b) {
+    int x=((const BitmapGlyph *)a)->code,y=((const BitmapGlyph *)b)->code;
+    return (x>y)-(x<y);
+}
+
+static int compareLoad(const void *a,const void *b) {
+    int result=compare(a,b);
+    if(result) return result;
+    return ((const BitmapGlyph *)a)->order-((const BitmapGlyph *)b)->order;
+}
+
+void bitmapFontFree(BitmapFont *font) {
+    if(font) {free(font->glyphs);free(font);}
+}
+
+BitmapFont *bitmapFontLoad(const char *path) {
+    FILE *file=fopen(path,"r");
+    if(!file) return NULL;
+    BitmapFont *font=calloc(1,sizeof(*font));
+    if(!font) {fclose(file);return NULL;}
+    char line[512]; int capacity=0,descent=0,row=-1,invalid=0,finished=0;
+    BitmapGlyph glyph={.code=-1};
+    while(fgets(line,sizeof(line),file)) {
+        if(!strncmp(line,"STARTFONT ",10)) {finished=0;row=-1;continue;}
+        int n;
+        if(sscanf(line,"FONT_ASCENT %d",&n)==1) {if(n>font->ascent) font->ascent=n;continue;}
+        if(sscanf(line,"FONT_DESCENT %d",&n)==1) {if(n>descent) descent=n;continue;}
+        if(sscanf(line,"CHARS %d",&n)==1) {
+            if(n<1 || n>65536-capacity) {invalid=1;break;}
+            BitmapGlyph *expanded=realloc(font->glyphs,(capacity+n)*sizeof(*font->glyphs));
+            if(!expanded) {invalid=1;break;}
+            font->glyphs=expanded;capacity+=n;
+        } else if(!strncmp(line,"STARTCHAR ",10)) {
+            memset(&glyph,0,sizeof(glyph));glyph.code=-1;row=-1;
+        } else if(sscanf(line,"ENCODING %d",&glyph.code)==1) {
+            continue;
+        } else if(sscanf(line,"DWIDTH %d",&glyph.advance)==1) {
+            continue;
+        } else if(sscanf(line,"BBX %d %d %d %d",&glyph.w,&glyph.h,&glyph.x,&glyph.y)==4) {
+            if(glyph.w<0 || glyph.w>32 || glyph.h<0 || glyph.h>32 ||
+               glyph.x<-64 || glyph.x>64 || glyph.y<-64 || glyph.y>64) {invalid=1;break;}
+        } else if(!strncmp(line,"BITMAP",6)) {
+            row=0;
+        } else if(!strncmp(line,"ENDCHAR",7)) {
+            if(row!=glyph.h || glyph.advance<0 || glyph.advance>64 || font->count>=capacity) {invalid=1;break;}
+            if(glyph.code>=0) {glyph.order=font->count;font->glyphs[font->count++]=glyph;}
+            row=-1;
+        } else if(!strncmp(line,"ENDFONT",7)) {
+            finished=1;row=-1;
+        } else if(row>=0) {
+            char *end;
+            if(row>=glyph.h) {invalid=1;break;}
+            unsigned long bits=strtoul(line,&end,16);
+            if(end==line || (*end!='\r' && *end!='\n' && *end!=0)) {invalid=1;break;}
+            glyph.rows[row++]=(Uint32)bits;
+        }
+    }
+    fclose(file);
+    font->height=font->ascent+descent;
+    if(invalid || !finished || !font->count || font->ascent<1 || font->height<1 || font->height>64) {
+        bitmapFontFree(font);return NULL;
+    }
+    qsort(font->glyphs,font->count,sizeof(*font->glyphs),compareLoad);
+    int unique=0;
+    for(int i=0;i<font->count;i++) {
+        if(unique && font->glyphs[unique-1].code==font->glyphs[i].code)
+            font->glyphs[unique-1]=font->glyphs[i];
+        else font->glyphs[unique++]=font->glyphs[i];
+    }
+    font->count=unique;
+    return font;
+}
+
+static unsigned int decode(const char **ptr) {
+    const unsigned char *p=(const unsigned char *)*ptr;
+    unsigned int code=*p++; int extra=0;
+    if(code>=0xc2 && code<=0xdf) {code&=31;extra=1;}
+    else if(code>=0xe0 && code<=0xef) {code&=15;extra=2;}
+    else if(code>=0xf0 && code<=0xf4) {code&=7;extra=3;}
+    else if(code>=0x80) code='?';
+    for(int i=0;i<extra;i++) {
+        if((*p&0xc0)!=0x80) {code='?';break;}
+        code=(code<<6)|(*p++&63);
+    }
+    *ptr=(const char *)p;return code;
+}
+
+static BitmapGlyph *lookup(BitmapFont *font,unsigned int code) {
+    BitmapGlyph key={.code=(int)code};
+    BitmapGlyph *glyph=bsearch(&key,font->glyphs,font->count,sizeof(key),compare);
+    if(!glyph && code!='?') return lookup(font,'?');
+    return glyph;
+}
+
+int bitmapFontHeight(BitmapFont *font) {return font->height;}
+int bitmapFontWidth(BitmapFont *font,const char *text) {
+    int width=0;
+    while(*text) {BitmapGlyph *g=lookup(font,decode(&text));width+=g?g->advance:font->height/2;}
+    return width;
+}
+
+void bitmapFontDraw(BitmapFont *font,const char *text,SDL_Surface *surface,int x,int y) {
+    int width=bitmapFontWidth(font,text);
+    if(width<1) return;
+    SDL_Surface *glyphs=SDL_CreateRGBSurface(SDL_SWSURFACE,width,font->height,32,
+                                           0x00ff0000,0x0000ff00,0x000000ff,0);
+    if(!glyphs) return;
+    SDL_FillRect(glyphs,NULL,0);
+    SDL_SetColorKey(glyphs,SDL_SRCCOLORKEY,0);
+    Uint32 white=SDL_MapRGB(glyphs->format,255,255,255);
+    int pen=0;
+    while(*text) {
+        BitmapGlyph *g=lookup(font,decode(&text));
+        if(!g) {pen+=font->height/2;continue;}
+        int top=font->ascent-g->h-g->y;
+        int stride=(g->w+7)/8*8;
+        for(int row=0;row<g->h;row++) for(int col=0;col<g->w;col++) {
+            int tx=pen+g->x+col,ty=top+row;
+            if(tx>=0 && tx<width && ty>=0 && ty<font->height &&
+               (g->rows[row]&((Uint32)1<<(stride-1-col)))) {
+                Uint32 *target=(Uint32 *)((Uint8 *)glyphs->pixels+ty*glyphs->pitch)+tx;
+                *target=white;
+            }
+        }
+        pen+=g->advance;
+    }
+    SDL_Rect target={x,y,0,0};
+    SDL_BlitSurface(glyphs,NULL,surface,&target);
+    SDL_FreeSurface(glyphs);
+}
