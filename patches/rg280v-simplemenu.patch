--- /dev/null
+++ b/simplemenu/src/logic/window_menu.c
@@ -0,0 +1,374 @@
+/* Optional, data-driven navigation layout. No section-specific background images. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <SDL/SDL.h>
+#include <SDL/SDL_ttf.h>
+#include <SDL/SDL_image.h>
+#include "../headers/globals.h"
+#include "../headers/definitions.h"
+#include "../headers/graphics.h"
+#include "../headers/logic.h"
+#include "../headers/ini2.h"
+#include "../headers/doubly_linked_rom_list.h"
+#include "../headers/window_menu.h"
+#include "../headers/bitmap_font.h"
+
+static ini_t *wmConfig;
+static TTF_Font *wmFont;
+static BitmapFont *wmBitmap;
+static SDL_Surface *wmBackground;
+static int wmBackgroundFrames;
+static SDL_Rect wmBoxes[8];
+static int wmEnabled, wmRows, wmLine,wmRom;
+static int wmSpeed=24,wmDelay=1000,wmPause=1000;
+static int wmKey[5],wmDistances[4],wmOffsets[4],wmHasKey;
+static Uint32 wmSelectionAt;
+static const char *boxKeys[] = {"heading", "list", "detail", "help", "counter",
+                              "rom_heading","rom_list","rom_counter"};
+
+void freeWindowMenu(void) {
+    if (wmFont) TTF_CloseFont(wmFont);
+    bitmapFontFree(wmBitmap); wmBitmap=NULL;
+    if(wmBackground) SDL_FreeSurface(wmBackground);
+    wmBackground=NULL;
+    if (wmConfig) ini_free(wmConfig);
+    wmFont = NULL; wmConfig = NULL; wmEnabled = 0;
+    wmHasKey=0;memset(wmDistances,0,sizeof(wmDistances));
+}
+
+void loadWindowMenu(const char *path) {
+    freeWindowMenu();
+    wmConfig = ini_load(path);
+    if (!wmConfig) return;
+    const char *enabled = ini_get(wmConfig, "WINDOW_MENU", "enabled");
+    if (!enabled || atoi(enabled) != 1) return;
+    const char *defaults[] = {"122,10,77,32", "222,10,87,190", "11,27,88,103",
+                             "61,150,88,84", "182,203,98,31",
+                             "8,8,188,26","8,40,304,192","204,8,108,26"};
+    wmRom=ini_get(wmConfig,"WINDOW_MENU","rom_list")!=NULL;
+    for (int i=0; i<(wmRom?8:5); i++) {
+        int x,y,w,h;
+        const char *value = ini_get(wmConfig,"WINDOW_MENU",boxKeys[i]);
+        if (sscanf(value ? value : defaults[i], "%d,%d,%d,%d", &x,&y,&w,&h)!=4 ||
+            x<0 || y<0 || w<24 || h<20 || x+w>SCREEN_WIDTH || y+h>SCREEN_HEIGHT) return;
+        wmBoxes[i]=(SDL_Rect){x,y,w,h};
+    }
+    const char *value = ini_get(wmConfig,"WINDOW_MENU","font_size");
+    int size = value ? atoi(value) : 10;
+    if (size<8 || size>18) return;
+    char fontPath[1024];
+    const char *root=getenv("PLUMOS_ROOT");
+    const char *fontFile=ini_get(wmConfig,"WINDOW_MENU","font");
+    if(fontFile && fontFile[0]=='/') snprintf(fontPath,sizeof(fontPath),"%s",fontFile);
+    else if(fontFile) {
+        const char *slash=strrchr(path,'/');
+        int prefix=slash?(int)(slash-path+1):0;
+        snprintf(fontPath,sizeof(fontPath),"%.*s%s",prefix,path,fontFile);
+    } else snprintf(fontPath,sizeof(fontPath),"%s/fonts/cjk-fallback.ttc",root?root:"/media/data/plumos");
+    size_t pathLength=strlen(fontPath);
+    if(pathLength>=4 && !strcasecmp(fontPath+pathLength-4,".bdf")) {
+        wmBitmap=bitmapFontLoad(fontPath);
+        if(!wmBitmap) return;
+        wmLine=bitmapFontHeight(wmBitmap)+1;
+        fprintf(stderr,"WINDOW_MENU bitmap=%s height=%d\n",fontPath,wmLine-1);
+    } else {
+        wmFont=TTF_OpenFont(fontPath,size);
+        if(!wmFont) return;
+        wmLine=TTF_FontHeight(wmFont)+1;
+    }
+    value=ini_get(wmConfig,"GENERAL","items");
+    wmRows=value?atoi(value):7;
+    if (wmRows<1 || wmRows>20 || wmRows*wmLine>wmBoxes[1].h-16) return;
+    if(wmRom && wmRows*wmLine>wmBoxes[6].h-16) return;
+    value=ini_get(wmConfig,"WINDOW_MENU","scroll_speed");wmSpeed=value?atoi(value):24;
+    value=ini_get(wmConfig,"WINDOW_MENU","scroll_delay");wmDelay=value?atoi(value):1000;
+    value=ini_get(wmConfig,"WINDOW_MENU","scroll_pause");wmPause=value?atoi(value):1000;
+    if(wmSpeed<1 || wmSpeed>120 || wmDelay<0 || wmDelay>10000 || wmPause<0 || wmPause>10000) return;
+    value=ini_get(wmConfig,"WINDOW_MENU","background_contains_frames");
+    wmBackgroundFrames=value?atoi(value):0;
+    const char *background=ini_get(wmConfig,"WINDOW_MENU","background");
+    if(background) {
+        char imagePath[1024];
+        if(background[0]=='/') snprintf(imagePath,sizeof(imagePath),"%s",background);
+        else {
+            const char *slash=strrchr(path,'/');
+            int prefix=slash?(int)(slash-path+1):0;
+            snprintf(imagePath,sizeof(imagePath),"%.*s%s",prefix,path,background);
+        }
+        SDL_Surface *raw=IMG_Load(imagePath);
+        if(raw) {
+            SDL_Surface *converted=SDL_ConvertSurface(raw,screen->format,SDL_SWSURFACE);
+            SDL_FreeSurface(raw);
+            wmBackground=SDL_CreateRGBSurface(SDL_SWSURFACE,SCREEN_WIDTH,SCREEN_HEIGHT,
+                screen->format->BitsPerPixel,screen->format->Rmask,screen->format->Gmask,
+                screen->format->Bmask,screen->format->Amask);
+            if(!converted || !wmBackground || SDL_SoftStretch(converted,NULL,wmBackground,NULL)<0) {
+                if(wmBackground) SDL_FreeSurface(wmBackground);
+                wmBackground=NULL;
+            }
+            if(converted) SDL_FreeSurface(converted);
+        }
+        if(!wmBackground) fprintf(stderr,"WINDOW_MENU background failed: %s\n",imagePath);
+    }
+    wmEnabled=1;
+}
+
+static const char *label(const char *name) {
+    const char *value=ini_get(wmConfig,"LABELS",name);
+    return value?value:name;
+}
+
+static const char *detailLabel(const char *name) {
+    const char *value=ini_get(wmConfig,"DETAIL_LABELS",name);
+    return value?value:name;
+}
+
+static const char *uiText(const char *key,const char *fallback) {
+    static char text[512];
+    const char *value=ini_get(wmConfig,"WINDOW_MENU",key);
+    if(!value) return fallback;
+    size_t out=0;
+    while(*value && out<sizeof(text)-1) {
+        if(value[0]=='\\' && value[1]=='n') {text[out++]='\n';value+=2;}
+        else text[out++]=*value++;
+    }
+    text[out]=0;
+    return text;
+}
+
+static void fill(int x,int y,int w,int h,int r,int g,int b) {
+    SDL_Rect rect={x,y,w,h};
+    SDL_FillRect(screen,&rect,SDL_MapRGB(screen->format,r,g,b));
+}
+
+static void frame(SDL_Rect box,int kind) {
+    /* Shared stepped silver frame, shaded interior, and black corner cutouts. */
+    int x=box.x,y=box.y,w=box.w,h=box.h;
+    fill(x+2,y,w-4,h,82,82,82); fill(x,y+2,w,h-4,82,82,82);
+    fill(x+2,y+1,w-4,h-2,230,230,230); fill(x+1,y+2,w-2,h-4,230,230,230);
+    fill(x+3,y+3,w-6,h-6,155,155,155);
+    fill(x+4,y+4,w-8,h-8,255,255,255);
+    for(int row=5;row<h-5;row++) {
+        int shade=(row-5)*12/(h-10);
+        fill(x+5,y+row,w-10,1,kind==1?110-shade:0,
+             kind==2?85-shade:0,kind==2?0:kind==1?90-shade:128-shade);
+    }
+}
+
+static size_t utfNext(const char *text,size_t offset) {
+    if (!text[offset]) return offset;
+    offset++;
+    while (text[offset] && ((unsigned char)text[offset]&0xc0)==0x80) offset++;
+    return offset;
+}
+
+/* Wrap on UTF-8 codepoint boundaries, measure with the actual rendering font. */
+static int textWidth(const char *text) {
+    if(wmBitmap) return bitmapFontWidth(wmBitmap,text);
+    int width=0;TTF_SizeUTF8(wmFont,text,&width,NULL);return width;
+}
+
+static int marqueeOffset(int slot) {
+    int distance=wmDistances[slot];
+    if(distance<=0) return 0;
+    Uint32 travel=((Uint32)distance*1000+wmSpeed-1)/wmSpeed;
+    Uint32 phase=(SDL_GetTicks()-wmSelectionAt)%(wmDelay+travel+wmPause);
+    if(phase<=(Uint32)wmDelay) return 0;
+    if(phase>=(Uint32)wmDelay+travel) return distance;
+    int offset=(phase-wmDelay)*wmSpeed/1000;
+    return offset<distance?offset:distance;
+}
+
+int windowMenuAnimate(void) {
+    if(!wmEnabled || !wmHasKey || isSuspended || (currentState!=CHOOSING_GROUP &&
+       currentState!=SELECTING_SECTION && currentState!=BROWSING_GAME_LIST)) return 0;
+    for(int i=0;i<4;i++) if(marqueeOffset(i)!=wmOffsets[i]) return 1;
+    return 0;
+}
+
+static void singleLine(const char *text,SDL_Rect box,int slot) {
+    if(!text) return;
+    int width=textWidth(text),offset=0;
+    if(slot>=0) {
+        wmDistances[slot]=width>box.w?width-box.w:0;
+        offset=marqueeOffset(slot);wmOffsets[slot]=offset;
+    }
+    SDL_Rect oldClip;SDL_GetClipRect(screen,&oldClip);SDL_SetClipRect(screen,&box);
+    if(wmBitmap) bitmapFontDraw(wmBitmap,text,screen,box.x-offset,box.y);
+    else {
+        SDL_Color white={255,255,255,0};
+        SDL_Surface *glyphs=TTF_RenderUTF8_Solid(wmFont,text,white);
+        if(glyphs) {SDL_Rect target={box.x-offset,box.y,0,0};SDL_BlitSurface(glyphs,NULL,screen,&target);SDL_FreeSurface(glyphs);}
+    }
+    SDL_SetClipRect(screen,&oldClip);
+}
+
+static int textBox(const char *text,SDL_Rect box,int lines,int center) {
+    if (!text || (!wmFont && !wmBitmap) || lines<1) return 0;
+    size_t length=strlen(text), start=0;
+    int drawn=0;
+    SDL_Rect oldClip; SDL_GetClipRect(screen,&oldClip); SDL_SetClipRect(screen,&box);
+    for (int row=0;row<lines && start<length && (row+1)*wmLine<=box.h;row++) {
+        char line[1024]; size_t end=start, fit=start;
+        while(end<length && text[end]!='\n') {
+            size_t next=utfNext(text,end);
+            if(next-start>=sizeof(line)-4) break;
+            memcpy(line,text+start,next-start); line[next-start]=0;
+            int width=textWidth(line);
+            if(width>box.w) break;
+            fit=next; end=next;
+        }
+        if(fit==start && text[start]!='\n') fit=utfNext(text,start);
+        size_t count=fit-start;
+        memcpy(line,text+start,count); line[count]=0;
+        if(row==lines-1 && fit<length && text[fit]!='\n') {
+            int width;
+            do {
+                strcpy(line+count,"..."); width=textWidth(line);
+                if(width<=box.w || !count) break;
+                do {count--;} while(count && ((unsigned char)line[count]&0xc0)==0x80);
+            } while(1);
+        }
+        if(wmBitmap) {
+            bitmapFontDraw(wmBitmap,line,screen,box.x+(center?(box.w-textWidth(line))/2:0),box.y+row*wmLine);
+        } else {
+            SDL_Color color={255,255,255,0};
+            SDL_Surface *glyphs=TTF_RenderUTF8_Solid(wmFont,line,color);
+            if(glyphs) {
+                SDL_Rect target={box.x+(center?(box.w-glyphs->w)/2:0),box.y+row*wmLine,0,0};
+                SDL_BlitSurface(glyphs,NULL,screen,&target); SDL_FreeSurface(glyphs);
+            }
+        }
+        start=fit;
+        if(text[start]=='\n') start++;
+        drawn=row+1;
+    }
+    SDL_SetClipRect(screen,&oldClip);
+    return drawn;
+}
+
+static void hand(int x,int y) {
+    /* One pixel-art pointing hand, translated to the selected row each draw. */
+    const char *pixels[]={"000111100000","001111110000","001111111111","111111111111",
+                          "111111111100","111111110000","001111110000","000111100000"};
+    for(int row=0;row<8;row++) for(int col=0;col<12;col++)
+        if(pixels[row][col]=='1') fill(x+col,y+row,1,1,255,255,255);
+}
+
+static char *romName(int index) {
+    if(favoritesSectionSelected) {
+        struct Favorite *fav=GetNthFavorite(index);
+        return strdup(fav?(strlen(fav->alias)>2?fav->alias:fav->name):"");
+    }
+    struct Node *node=GetNthNode(index);
+    if(!node || !node->data) return strdup("");
+    return getFileNameOrAlias((struct Rom *)node->data);
+}
+
+int drawWindowMenu(void) {
+    if(!wmEnabled || (currentState!=CHOOSING_GROUP && currentState!=SELECTING_SECTION &&
+                     currentState!=BROWSING_GAME_LIST)) {wmHasKey=0;return 0;}
+    int key[]={currentState,activeGroup,currentSectionNumber,CURRENT_GAME_NUMBER,favoritesSectionSelected};
+    if(!wmHasKey || memcmp(key,wmKey,sizeof(key))) {
+        memcpy(wmKey,key,sizeof(key));wmSelectionAt=SDL_GetTicks();wmHasKey=1;
+        memset(wmOffsets,0,sizeof(wmOffsets));
+    }
+    memset(wmDistances,0,sizeof(wmDistances));
+    fill(0,0,SCREEN_WIDTH,SCREEN_HEIGHT,0,0,0);
+    if(wmRom && currentState==BROWSING_GAME_LIST) {
+        frame(wmBoxes[5],1);frame(wmBoxes[6],0);frame(wmBoxes[7],2);
+        SDL_Rect box=wmBoxes[5];box.x+=8;box.w-=16;box.y+=(box.h-wmLine)/2;
+        singleLine(label(CURRENT_SECTION.sectionName),box,3);
+        int selected=CURRENT_GAME_NUMBER,total=CURRENT_SECTION.gameCount;
+        int first=selected/wmRows*wmRows,rowHeight=(wmBoxes[6].h-16)/wmRows;
+        for(int row=0;row<wmRows && first+row<total;row++) {
+            char *name=romName(first+row);
+            box=wmBoxes[6];box.x+=19;box.w-=25;
+            box.y+=9+row*rowHeight+(rowHeight-wmLine)/2;box.h=wmLine;
+            if(first+row==selected) {
+                hand(wmBoxes[6].x+5,box.y+3);singleLine(name,box,0);
+            } else textBox(name,box,1,0);
+            free(name);
+        }
+        char count[80];snprintf(count,sizeof(count),"%d / %d",total?selected+1:0,total);
+        box=wmBoxes[7];box.x+=6;box.w-=12;box.y+=(box.h-wmLine)/2;
+        textBox(count,box,1,1);
+        return 1;
+    }
+    if(wmBackground) SDL_BlitSurface(wmBackground,NULL,screen,NULL);
+    if(!wmBackground || !wmBackgroundFrames)
+        for(int i=0;i<5;i++) frame(wmBoxes[i],i==0?1:i==4?2:0);
+    int selected,total;
+    const char *heading;
+    if(currentState==CHOOSING_GROUP) {
+        selected=activeGroup; total=sectionGroupCounter; heading=uiText("title","plumOS");
+    } else if(currentState==SELECTING_SECTION) {
+        selected=currentSectionNumber; total=menuSectionCounter-1;
+        if(selected==favoritesSectionNumber) total=menuSectionCounter;
+        heading=label(sectionGroups[activeGroup].groupName);
+    } else {
+        selected=CURRENT_GAME_NUMBER; total=CURRENT_SECTION.gameCount;
+        heading=label(CURRENT_SECTION.sectionName);
+    }
+    SDL_Rect box=wmBoxes[0]; box.x+=6;box.w-=12;box.y+=(box.h-wmLine)/2;
+    int headingWidth=textWidth(heading);
+    if(headingWidth<box.w) {int inset=(box.w-headingWidth)/2;box.x+=inset;box.w-=inset;}
+    singleLine(heading,box,3);
+    int first=selected/wmRows*wmRows;
+    int rowHeight=(wmBoxes[1].h-16)/wmRows;
+    char *selectedName=NULL;
+    for(int row=0;row<wmRows && first+row<total;row++) {
+        int index=first+row;
+        const char *name;
+        char *owned=NULL;
+        if(currentState==CHOOSING_GROUP) name=label(sectionGroups[index].groupName);
+        else if(currentState==SELECTING_SECTION) name=label(menuSections[index].sectionName);
+        else {owned=romName(index);name=owned;}
+        box=wmBoxes[1];box.x+=19;box.y+=9+row*rowHeight;box.w-=25;box.h=wmLine;
+        if(index==selected) singleLine(name,box,0);
+        else textBox(name,box,1,0);
+        if(index==selected) {
+            hand(wmBoxes[1].x+5,box.y+3);
+            const char *description=name;
+            if(currentState==CHOOSING_GROUP) description=detailLabel(sectionGroups[index].groupName);
+            else if(currentState==SELECTING_SECTION) description=detailLabel(menuSections[index].sectionName);
+            selectedName=strdup(description);
+        }
+        free(owned);
+    }
+    box=wmBoxes[2];box.x+=7;box.y+=8;box.w-=14;box.h-=16;
+    singleLine(selectedName?selectedName:"",box,1);
+    int titleRows=1;
+    SDL_Rect detail=box; detail.y+=titleRows*wmLine+7;
+    int available=box.y+box.h-detail.y;
+    detail.h=available>0?available:0;
+    if(currentState==CHOOSING_GROUP) textBox(uiText("choose_category","Choose a\ncategory"),detail,2,0);
+    else if(currentState==SELECTING_SECTION) textBox(uiText("choose_system","Choose a\nsystem"),detail,2,0);
+    else {
+        const char *profile=uiText("default_core","Default core");
+        if(!favoritesSectionSelected && CURRENT_SECTION.currentGameNode) {
+            struct Rom *rom=CURRENT_SECTION.currentGameNode->data;
+            int emu=rom->preferences.emulator;
+            if(emu>=0 && emu<10 && CURRENT_SECTION.executables[emu]) {
+                const char *shortName=strstr(CURRENT_SECTION.executables[emu],"__");
+                if(shortName && strcmp(shortName+2,"Default")) profile=shortName+2;
+            }
+        }
+        singleLine(profile,detail,2);
+        int profileRows=1;
+        if(!favoritesSectionSelected && CURRENT_SECTION.currentGameNode &&
+           doesFavoriteExist(((struct Rom *)CURRENT_SECTION.currentGameNode->data)->name)) {
+            detail.y+=profileRows*wmLine+2; available=box.y+box.h-detail.y;
+            detail.h=available>0?available:0;
+            if(detail.h>0) textBox(uiText("favorite","Favorite"),detail,1,0);
+        }
+    }
+    free(selectedName);
+    box=wmBoxes[3];box.x+=8;box.y+=9;box.w-=16;
+    textBox(uiText("help_text","A: Select\nB: Back\nSTART: Setup"),box,5,0);
+    char count[80];snprintf(count,sizeof(count),"%d / %d",total?selected+1:0,total);
+    box=wmBoxes[4];box.x+=6;box.w-=12;box.y+=(box.h-wmLine)/2;
+    textBox(count,box,1,1);
+    return 1;
+}
