+/* Keep the theme font wherever it has the requested glyphs. */
+static TTF_Font *plumosCjkFonts[96];
+static TTF_Font *plumosFontForText(TTF_Font *original, const char *text) {
+    const unsigned char *p = (const unsigned char *)text;
+    int missing = 0;
+    if (!original || !text) return original;
+    while (*p) {
+        unsigned int cp = *p++;
+        int remaining = 0;
+        if (cp >= 0xf0) { cp &= 7; remaining = 3; }
+        else if (cp >= 0xe0) { cp &= 15; remaining = 2; }
+        else if (cp >= 0xc0) { cp &= 31; remaining = 1; }
+        while (remaining-- > 0 && *p && (*p & 0xc0) == 0x80) cp = (cp << 6) | (*p++ & 63);
+        if (cp > 127 && cp != 0x3000) {
+            int minx, maxx, miny, maxy, advance;
+            if (cp > 65535 || !TTF_GlyphIsProvided(original, (Uint16)cp) ||
+                TTF_GlyphMetrics(original, (Uint16)cp, &minx, &maxx, &miny, &maxy, &advance) < 0 ||
+                maxx <= minx || maxy <= miny) missing = 1;
+        }
+    }
+    if (missing) {
+        int height = TTF_FontHeight(original);
+        if (height < 6) height = 6;
+        if (height > 95) height = 95;
+        if (!plumosCjkFonts[height]) {
+            const char *root = getenv("PLUMOS_ROOT");
+            char path[1024];
+            snprintf(path, sizeof(path), "%s/fonts/cjk-fallback.ttc", root ? root : "/media/data/plumos");
+            plumosCjkFonts[height] = TTF_OpenFont(path, height * 2 / 3);
+        }
+        if (plumosCjkFonts[height]) return plumosCjkFonts[height];
+    }
+    return original;
+}
+static void plumosCloseCjkFonts(void) {
+    for (int i=0;i<96;i++) {
+        if (plumosCjkFonts[i]) TTF_CloseFont(plumosCjkFonts[i]);
+        plumosCjkFonts[i] = NULL;
+    }
+}
+#endif
