+#include "rg350m-family.dtsi"
+
+&pinctrl {
+	gpios_i2c0: gpios-i2c0 {
+		pins = "PD30", "PD31";
+		bias-pull-up;
+	};
+};
+
+/* Use GPIO I2C for the IT66121 bridge, as on the RG-300X. */
+&i2c0 {
+	compatible = "i2c-gpio";
+	sda-gpios = <&gpd 30 GPIO_ACTIVE_HIGH>;
+	scl-gpios = <&gpd 31 GPIO_ACTIVE_HIGH>;
+	pinctrl-0 = <&gpios_i2c0>;
+};
