diff --git a/src/gui/Dialog.cxx b/src/gui/Dialog.cxx
index fed0552..93ef06c 100644
--- a/src/gui/Dialog.cxx
+++ b/src/gui/Dialog.cxx
@@ -336,6 +336,34 @@ void Dialog::handleKeyDown(StellaKey key, StellaMod mod, char ascii)
   // Shift-Tab sets previous widget in current tab
   Event::Type e = Event::NoType;
 
+#ifdef PLUMOS_RG280V
+  // Widgets such as lists/sliders consume directions. Buttons do not, so
+  // fall back to focus navigation without requiring an analog mouse.
+  if(_focusedWidget && !_focusedWidget->wantsRaw()) {
+    Event::Type direction = Event::NoType;
+    if(key == KBDK_UP) direction = Event::UIUp;
+    else if(key == KBDK_DOWN) direction = Event::UIDown;
+    else if(key == KBDK_LEFT) direction = Event::UILeft;
+    else if(key == KBDK_RIGHT) direction = Event::UIRight;
+    if(direction != Event::NoType) {
+      if(!_focusedWidget->handleEvent(direction))
+        handleNavEvent(key == KBDK_UP || key == KBDK_LEFT
+                       ? Event::UINavPrev : Event::UINavNext);
+      return;
+    }
+    // L/R move focus even when a list or slider consumes the D-pad.
+    if(key == KBDK_TAB || key == KBDK_BACKSPACE) {
+      handleNavEvent(key == KBDK_TAB ? Event::UINavPrev : Event::UINavNext);
+      return;
+    }
+    // X/Y select tabs without desktop Shift shortcuts.
+    if(key == KBDK_SPACE || key == KBDK_LSHIFT) {
+      cycleTab(key == KBDK_SPACE ? 1 : -1);
+      return;
+    }
+  }
+#endif
+
   // Detect selection of previous and next tab headers and objects
   // For some strange reason, 'tab' needs to be interpreted as keycode,
   // not ascii??
