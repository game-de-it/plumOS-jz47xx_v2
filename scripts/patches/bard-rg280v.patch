diff --git a/src/display.c b/src/display.c
index ed3c17d..693a023 100644
--- a/src/display.c
+++ b/src/display.c
@@ -82,10 +82,25 @@ bard_display *bard_display_open(cst_features *config)
         display->screen_height = display->hardware_height;
 
     display->screen_depth = BARD_DISPLAY_SCREEN_DEPTH;
+#ifdef PLUMOS_RG280V
+    display->video_screen = SDL_SetVideoMode(display->screen_width,
+                                             display->screen_height * 2,
+                                             display->screen_depth,
+                                             SDL_SWSURFACE);
+    if (display->video_screen != NULL)
+        display->screen = SDL_CreateRGBSurface(SDL_SWSURFACE,
+            display->screen_width, display->screen_height,
+            display->video_screen->format->BitsPerPixel,
+            display->video_screen->format->Rmask,
+            display->video_screen->format->Gmask,
+            display->video_screen->format->Bmask,
+            display->video_screen->format->Amask);
+#else
     display->screen = SDL_SetVideoMode(display->screen_width,
                                        display->screen_height,
                                        display->screen_depth,
                                        SDL_SWSURFACE);
+#endif
     if (display->screen == NULL)
     {
         bard_display_close(display);
@@ -129,6 +144,10 @@ void bard_display_close(bard_display *display)
 
     if (display->screen)
         SDL_FreeSurface(display->screen);
+#ifdef PLUMOS_RG280V
+    if (display->video_screen)
+        SDL_FreeSurface(display->video_screen);
+#endif
     if (display->font)
         bard_font_delete(display->font);
 
@@ -187,6 +206,11 @@ void bard_display_update(bard_display *d)
 
     SDL_BlitSurface(d->current->surface,&offset2,d->screen,&offset);
 
+#ifdef PLUMOS_RG280V
+    SDL_SoftStretch(d->screen, NULL, d->video_screen, NULL);
+    SDL_Flip(d->video_screen);
+#else
     SDL_Flip(d->screen);
+#endif
     return;
 }
