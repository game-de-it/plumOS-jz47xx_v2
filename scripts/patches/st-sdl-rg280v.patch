@@ -255,6 +259,14 @@ int compute_new_col(int visual_offset, int old_row, int new_row) {
 
 int handle_keyboard_event(SDL_Event* event) {
 	static int visual_offset = 0;
+#ifdef PLUMOS_RG280V
+	static int select_held = 0, start_held = 0;
+	if (event->key.keysym.sym == SDLK_ESCAPE)
+		select_held = event->key.type == SDL_KEYDOWN;
+	if (event->key.keysym.sym == SDLK_RETURN)
+		start_held = event->key.type == SDL_KEYDOWN;
+	if (select_held && start_held) exit(0);
+#endif
 	if(event->key.type == SDL_KEYDOWN && !(event->key.keysym.mod & KMOD_SYNTHETIC) && event->key.keysym.sym == KEY_ACTIVATE) {
 		active = ! active;
 		return 1;
