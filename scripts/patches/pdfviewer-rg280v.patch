diff --git a/xpvideo.cpp b/xpvideo.cpp
index 1cf6738..1daeb20 100644
--- a/xpvideo.cpp
+++ b/xpvideo.cpp
@@ -10,7 +10,10 @@
 #include <string.h>
 #include "xpvideo.h"
 
-SDL_Surface *screen = NULL;
+SDL_Surface *screen = NULL;
+#ifdef PLUMOS_RG280V
+static SDL_Surface *video_screen = NULL;
+#endif
 static SDL_Joystick *m_joy = NULL;
 static int m_txcolor = 0xffffffff; // en RGBA
 
@@ -38,7 +41,16 @@ bool VideoInit()
 
   // create the screen surface, 24 bits rgb (ikari)
 #ifdef GCW0 //David Knight --Added Hardware triplebuffering
-  screen = SDL_SetVideoMode(SCR_WIDTH, SCR_HEIGHT, 16, SDL_HWSURFACE|SDL_DOUBLEBUF);
+#ifdef PLUMOS_RG280V
+  video_screen = SDL_SetVideoMode(SCR_WIDTH, SCR_HEIGHT * 2, 16, SDL_SWSURFACE);
+  if (!video_screen) return false;
+  screen = SDL_CreateRGBSurface(SDL_SWSURFACE, SCR_WIDTH, SCR_HEIGHT,
+      video_screen->format->BitsPerPixel, video_screen->format->Rmask,
+      video_screen->format->Gmask, video_screen->format->Bmask,
+      video_screen->format->Amask);
+#else
+  screen = SDL_SetVideoMode(SCR_WIDTH, SCR_HEIGHT, 16, SDL_HWSURFACE|SDL_DOUBLEBUF);
+#endif
 #else
   screen = SDL_SetVideoMode(SCR_WIDTH, SCR_HEIGHT, 16, SDL_SWSURFACE);
 #endif
@@ -72,6 +84,10 @@ void VideoDone()
   // cerrar el joystick
   if(SDL_JoystickOpened(0))
      SDL_JoystickClose(m_joy);
+#ifdef PLUMOS_RG280V
+  SDL_FreeSurface(screen);
+  screen = NULL;
+#endif
   SDL_Quit();
 
 #ifdef GPHMODE
@@ -80,6 +96,17 @@ void VideoDone()
 #endif
 }
 
+int VideoFlip()
+{
+#ifdef PLUMOS_RG280V
+  if (!screen || !video_screen) return -1;
+  if (SDL_SoftStretch(screen, NULL, video_screen, NULL) < 0) return -1;
+  return SDL_Flip(video_screen);
+#else
+  return SDL_Flip(screen);
+#endif
+}
+
 // lee tecla con repetición sin bloqueo
 int ReadKey()
 {
@@ -269,6 +296,9 @@ int ReadKey()
         if (keystates[SDLK_UP]    && keystates[SDLK_RIGHT]) ret = KEY_UPRIGHT;
         if (keystates[SDLK_DOWN]  && keystates[SDLK_LEFT])  ret = KEY_DOWNLEFT;
         if (keystates[SDLK_DOWN]  && keystates[SDLK_RIGHT]) ret = KEY_DOWNRIGHT;
+#ifdef PLUMOS_RG280V
+        if (keystates[SDLK_ESCAPE] && keystates[SDLK_RETURN]) exit(0);
+#endif
         if (keystates[SDLK_LCTRL])                         {ret = KEY_FB;
             SDL_Delay(100);
         }
