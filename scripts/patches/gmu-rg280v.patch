diff --git a/src/frontends/sdl/sdl.c b/src/frontends/sdl/sdl.c
index af4a4d8..e6fc781 100644
--- a/src/frontends/sdl/sdl.c
+++ b/src/frontends/sdl/sdl.c
@@ -619,9 +619,16 @@ static void run_player(char *skin_name, char *decoders_str)
 	}
 
 	if (quit == DONT_QUIT) {
+	#ifdef PLUMOS_RG280V
+		/* The RG280V panel presents a 320x480 framebuffer as 320x240. */
+		SDL_Surface *tmp = SDL_CreateRGBSurface(SDL_SWSURFACE, 320,
+		                                        240, display->format->BitsPerPixel,
+		                                        0, 0, 0, 0);
+	#else
 		SDL_Surface *tmp = SDL_CreateRGBSurface(SDL_SWSURFACE, display->w,
 		                                        display->h, display->format->BitsPerPixel,
 		                                        0, 0, 0, 0);
+	#endif
 		buffer = SDL_DisplayFormat(tmp);
 		SDL_FreeSurface(tmp);
 
diff --git a/src/frontends/sdl/skin.c b/src/frontends/sdl/skin.c
index 40616f8..e1cca73 100644
--- a/src/frontends/sdl/skin.c
+++ b/src/frontends/sdl/skin.c
@@ -293,6 +293,10 @@ static void skin_draw_widget(Skin *skin, GmuWidget *gw, SDL_Surface *buffer)
 
 static void skin_update_widget(Skin *skin, GmuWidget *gw, SDL_Surface *display, SDL_Surface *buffer)
 {
+	#ifdef PLUMOS_RG280V
+	SDL_SoftStretch(buffer, NULL, display, NULL);
+	SDL_UpdateRect(display, 0, 0, 0, 0);
+	#else
 	SDL_Rect srect, drect;
 
 	srect.x = gmu_widget_get_pos_x(gw, 0);
@@ -303,6 +307,7 @@ static void skin_update_widget(Skin *skin, GmuWidget *gw, SDL_Surface *display,
 	drect.y = srect.y;
 	SDL_BlitSurface(buffer, &srect, display, &drect);
 	SDL_UpdateRects(display, 1, &drect);
+	#endif
 }
 
 void skin_update_display(Skin *skin, SDL_Surface *display, SDL_Surface *buffer)
@@ -347,7 +352,11 @@ void skin_draw_footer_bg(Skin *skin, SDL_Surface *buffer)
 
 void skin_update_bg(const Skin *skin, SDL_Surface *display, SDL_Surface *buffer)
 {
+	#ifdef PLUMOS_RG280V
+	SDL_SoftStretch(buffer, NULL, display, NULL);
+	#else
 	SDL_BlitSurface(buffer, NULL, display, NULL);
+	#endif
 	SDL_UpdateRect(display, 0, 0, 0, 0);
 }
 
