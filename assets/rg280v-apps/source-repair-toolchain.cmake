set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR mipsel)
set(_sdk /workspace/output/rg280v/host)
set(CMAKE_C_COMPILER ${_sdk}/bin/mipsel-gcw0-linux-uclibc-gcc)
set(CMAKE_CXX_COMPILER ${_sdk}/bin/mipsel-gcw0-linux-uclibc-g++)
set(CMAKE_SYSROOT ${_sdk}/mipsel-gcw0-linux-uclibc/sysroot)
set(CMAKE_FIND_ROOT_PATH ${CMAKE_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-mips32r2 -msoft-float -fcommon")
set(CMAKE_CXX_FLAGS_INIT "-mips32r2 -msoft-float -fcommon")
