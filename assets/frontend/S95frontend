#!/bin/sh
root=/media/data/plumos
pidfile=/var/run/plumos-fe.pid
updater=$root/bin/plumos-jz47xx-system-update
ready=/tmp/plumos-fe-ready
case "${1:-}" in
    start)
        [ -x "$root/bin/plumos-fe-launch" ] || exit 0
        if [ -r "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
            exit 0
        fi
        mkdir -p "$root/Logs" "$root/state/frontend"
        if [ -x "$updater" ]; then
            "$updater" apply >>"$root/Logs/system-update.log" 2>&1 ||
                "$updater" rollback >>"$root/Logs/system-update.log" 2>&1 || exit 1
        fi
        . "$root/bin/plumos-jz47xx-media-env" || exit 1
        plumos_select_media
        # Discard an index for the other card when SD2 is added or removed.
        # ROM lists refresh on entry, and TOP has a manual refresh.
        if ! grep -Fqx "  \"rom_root\": \"$PLUMOS_ROM_ROOT\"," \
            "$root/state/frontend/library-index.json" 2>/dev/null; then
            PLUMOS_ROOT="$root" \
                "$root/bin/plumos-library-scan" >>"$root/Logs/frontend.log" 2>&1
        fi
        # The DRM frontend can expose the old fbdev status image when an OPK
        # releases the display. Keep that backing framebuffer black.
        if [ -c /dev/fb0 ]; then
            dd if=/dev/zero of=/dev/fb0 bs=4096 count=150 2>/dev/null || true
        fi
        rm -f "$ready"
        nohup setsid "$root/bin/plumos-fe-launch" </dev/null >>"$root/Logs/frontend.log" 2>&1 &
        pid=$!
        echo "$pid" >"$pidfile"
        if [ -x "$updater" ] && "$updater" pending; then
            remaining=20
            while kill -0 "$pid" 2>/dev/null && [ "$remaining" -gt 0 ]; do
                if grep -Fxq "pid=$pid" "$ready" 2>/dev/null; then
                    "$updater" confirm >>"$root/Logs/system-update.log" 2>&1 && exit 0
                    break
                fi
                sleep 1
                remaining=$((remaining - 1))
            done
            "$0" stop
            "$updater" rollback >>"$root/Logs/system-update.log" 2>&1 || exit 1
            exec "$0" start
        fi
        ;;
    stop)
        if [ -r "$pidfile" ]; then
            old_pid=$(cat "$pidfile")
            kill "$old_pid" 2>/dev/null || true
            # Let the previous process release DRM before starting a new one.
            attempt=0
            while kill -0 "$old_pid" 2>/dev/null && [ "$attempt" -lt 30 ]; do
                sleep 0.1
                attempt=$((attempt + 1))
            done
            rm -f "$pidfile"
        fi
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
esac
