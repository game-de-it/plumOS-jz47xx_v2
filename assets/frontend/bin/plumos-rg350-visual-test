#!/bin/sh
# Isolated visual test launcher. Only known case IDs can be run.
set -eu
base=/media/data/local/rg350-visual-tests
rombase=/media/data/sd2/.plumos-rg350-tests-20261118/relocated/visual-roms
case "${1:-}" in
    atari_caverns) opk=atari-input.opk; rom="$rombase/atari/CavernsOfMars.car" ;;
    atari_miner) opk=atari-input.opk; rom="$rombase/atari/Miner2049er.car" ;;
    atari_food) opk=atari-input.opk; rom="$rombase/atari/FoodFight.rom" ;;
    fba_kungfum) opk=fba-softfloat.opk; rom="$rombase/fba/kungfum.zip" ;;
    fba_bchopper) opk=fba-softfloat.opk; rom="$rombase/fba/bchopper.zip" ;;
    fba_nspirit) opk=fba-softfloat.opk; rom="$rombase/fba/nspirit.zip" ;;
    temper_airzonk) opk=temper-noipu.opk; rom=/media/data/sd2/roms/pcengine/AirZonk_U.pce ;;
    temper_blazing) opk=temper-noipu.opk; rom=/media/data/sd2/roms/pcengine/BlazingLazers_U.pce ;;
    temper_bonk) opk=temper-noipu.opk; rom=/media/data/sd2/roms/pcengine/BONKs_REVENGE.PCE ;;
    *) echo "Unknown visual test: ${1:-}" >&2; exit 2 ;;
esac
[ -f "$base/opk/$opk" ] || { echo "Missing OPK: $opk" >&2; exit 1; }
[ -f "$rom" ] || { echo "Missing ROM: $rom" >&2; exit 1; }
root=${PLUMOS_ROOT:-/media/data/plumos}
"$root/bin/plumos-prepare-opk-input"
mkdir -p "$root/home" "$base/log"
export PLUMOS_ROOT="$root" HOME="$root/home" SDL_VIDEODRIVER=kmsdrm
export LD_LIBRARY_PATH="$base/lib:$root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
printf '%s\tSTART\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$1" >>"$base/log/runs.tsv"
set +e
/usr/bin/opkrun "$base/opk/$opk" "$rom" >"$base/log/$1.log" 2>&1
rc=$?
printf '%s\tFINISH\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$1" "$rc" >>"$base/log/runs.tsv"
exit "$rc"
