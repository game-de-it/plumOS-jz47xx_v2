#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
    echo 'usage: plumos-standalone-launch EMULATOR ROM' >&2
    exit 2
fi

root=${PLUMOS_ROOT:-/media/data/plumos}
case "$1" in
    atari800|fba44|temper|fceux223|genesisgx|pokemini|race|crocods|gambatte2020|ohboy|stella|neo4all|handy|oswan|smsplusgg|smsplusms|unrealspeccy|gngeo|uae4all)
        exec "$root/bin/plumos-opk-emulator-launch" "$@"
        ;;
    pcsx4all) binary="$root/bin/pcsx4all" ;;
    fceux)
        opk="$root/emulators/fceux_gcw0-2.6.6-2023-08-30.opk"
        export LD_PRELOAD="$root/lib/libfceux-menu.so${LD_PRELOAD:+:$LD_PRELOAD}"
        "$root/bin/plumos-fceux-prepare" "$2"
        ;;
    gambatte)
        opk="$root/emulators/gambatte-dms-rg280v.opk"
        export LD_PRELOAD="$root/lib/libgambatte-menu.so${LD_PRELOAD:+:$LD_PRELOAD}"
        ;;
    pocketsnes) opk="$root/emulators/PocketSNES_2019-12-12.opk" ;;
    regba)
        opk="$root/emulators/ReGBA_1.9.2_rg280v.opk"
        export LD_PRELOAD="$root/lib/libregba-doublebuf.so${LD_PRELOAD:+:$LD_PRELOAD}"
        export SDL_VIDEO_KMSDRM_SCALING_MODE=1
        export SDL_VIDEO_KMSDRM_SCALING_SHARPNESS=0
        config="$root/home/.gpsp/global_config.cfg"
        if [ ! -e "$config" ]; then
            mkdir -p "$(dirname "$config")"
            cp "$root/config/regba-global-config.cfg" "$config"
        fi
        ;;
    picodrive)
        opk="$root/emulators/PicoDrive_rg280v.opk"
        export PICOFE_GL=0
        case "$2" in
            */roms/mastersystem/*|*/roms/gamegear/*|*.sms|*.SMS|*.gg|*.GG)
                export PLUMOS_SEGA8_NO_FF=1 PLUMOS_PICODRIVE_SEGA8_CANVAS=1
                ;;
        esac
        ;;
    *) echo "unsupported emulator: $1" >&2; exit 2 ;;
esac

if [ -n "${binary:-}" ]; then
    [ -x "$binary" ] || { echo "emulator missing: $binary" >&2; exit 1; }
else
    [ -r "$opk" ] || { echo "emulator missing: $opk" >&2; exit 1; }
fi
[ -f "$2" ] || { echo "ROM missing: $2" >&2; exit 1; }
"$root/bin/plumos-prepare-opk-input"
mkdir -p "$root/home"
export HOME="$root/home"
export LD_LIBRARY_PATH="$root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ "$1" = pcsx4all ]; then
    mkdir -p "$HOME/.pcsx4all"
    if [ ! -e "$HOME/.pcsx4all/bios" ]; then
        ln -s "$root/bios" "$HOME/.pcsx4all/bios"
    fi
    rom=$2
    case "$rom" in
        *.m3u|*.M3U)
            first=$(awk '!/^[[:space:]]*(#|$)/ { sub(/\r$/, ""); print; exit }' "$rom")
            [ -n "$first" ] || { echo "empty PSX playlist: $rom" >&2; exit 1; }
            case "$first" in
                /*) rom=$first ;;
                *) rom="$(dirname "$rom")/$first" ;;
            esac
            [ -f "$rom" ] || { echo "PSX disc missing: $rom" >&2; exit 1; }
            ;;
    esac
    export SDL_VIDEODRIVER=kmsdrm
    exec "$binary" -iso "$rom"
fi
exec /usr/bin/opkrun "$opk" "$2"
