#!/bin/sh
set -eu

case "${1:-}" in
    init|status)
        amixer sget PCM >/dev/null
        ;;
    apply)
        value=${2:?volume 0..20 required}
        case "$value" in ''|*[!0-9]*) exit 2 ;; esac
        [ "$value" -le 20 ] || exit 2
        percent=$((value * 5))
        amixer -q sset PCM "${percent}%"
        ;;
    *) exit 2 ;;
esac
