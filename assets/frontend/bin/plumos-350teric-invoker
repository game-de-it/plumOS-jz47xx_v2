#!/bin/sh
# Esoteric execs this process after releasing SDL; return to it after the child exits.
set -u
root=${PLUMOS_ROOT:-/media/data/plumos}
unset SDL_VIDEO_KMSDRM_SCALING_MODE
"$@"
rc=$?
printf '350teric child exit=%s\n' "$rc"
# Return to the existing supervisor; avoid nesting another shell on each game.
exit 75
