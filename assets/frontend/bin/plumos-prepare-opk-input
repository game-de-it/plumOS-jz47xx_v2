#!/bin/sh
set -eu

root=${PLUMOS_ROOT:-/media/data/plumos}
rule="$root/config/70-plumos-gpio-keys.rules"

# Boot-time preparation and a rapid game launch may overlap. Keep one udev
# initialization in flight and let the launcher wait only if it is still busy.
mkdir -p /run/plumos
exec 9>/run/plumos/prepare-opk-input.lock
flock 9

for event in /sys/class/input/event*; do
    [ -e "$event" ] || continue
    [ "$(cat "$event/device/name" 2>/dev/null)" = gpio-keys ] || continue

    if udevadm info --query=property --name="/dev/input/${event##*/}" \
        | grep -qx 'ID_INPUT_KEY=1'; then
        continue
    fi

    # SDL's libudev lookup reads this runtime database. Register the fixed
    # gpio-keys device directly, without waiting for udevd's first startup.
    # Preserve any existing metadata when another service populated the entry.
    db="/run/udev/data/c$(cat "$event/dev")"
    mkdir -p /run/udev/data
    if [ -e "$db" ]; then
        printf 'E:ID_INPUT=1\nE:ID_INPUT_KEY=1\n' >>"$db"
    else
        printf 'I:1\nE:ID_INPUT=1\nE:ID_INPUT_KEY=1\n' >"$db"
    fi
    if udevadm info --query=property --name="/dev/input/${event##*/}" \
        | grep -qx 'ID_INPUT_KEY=1'; then
        continue
    fi

    [ -r "$rule" ] || {
        echo "GPIO key udev rule missing: $rule" >&2
        exit 1
    }
    mkdir -p /run/udev/rules.d
    cp "$rule" /run/udev/rules.d/70-plumos-gpio-keys.rules
    if ! pidof udevd >/dev/null 2>&1; then
        # The daemon must not inherit the preparation lock after we exit.
        /sbin/udevd --daemon 9>&-
    fi
    udevadm control --reload
    udevadm test "$event" >/dev/null 2>&1
    udevadm info --query=property --name="/dev/input/${event##*/}" \
        | grep -qx 'ID_INPUT_KEY=1' || {
            echo "Could not register GPIO keys for OPK: ${event##*/}" >&2
            exit 1
        }
done
