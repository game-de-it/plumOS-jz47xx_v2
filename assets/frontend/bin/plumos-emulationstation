#!/bin/sh
set -eu
root=${PLUMOS_ROOT:-/media/data/plumos}
export PLUMOS_ROOT="$root" HOME="$root/home/emulationstation"
export XDG_CACHE_HOME="$HOME/.cache"
export LD_LIBRARY_PATH="$root/emulationstation/lib:$root/lib"
export SDL_VIDEODRIVER=kmsdrm LANG=C LC_ALL=C
# Isolate the etnaviv tiled-blit fix from the OS driver and child emulators.
export LIBGL_DRIVERS_PATH="$root/emulationstation/dri"
mkdir -p "$XDG_CACHE_HOME"
"$root/bin/plumos-prepare-opk-input"
cd "$root/emulationstation"
set +e
./emulationstation --resolution 320 240 >>"$root/Logs/emulationstation.log" 2>&1
rc=$?
printf 'EmulationStation exit=%s\n' "$rc" >>"$root/Logs/emulationstation.log"
exit "$rc"
