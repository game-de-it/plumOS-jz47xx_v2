#!/bin/sh
# Installed on the shared SD1 image. Run after the frontend service is started.
set -eu
[ "${1:-}" = start ] || exit 0
[ -c /dev/fb0 ] || exit 0
[ "$(cat /boot/model.txt 2>/dev/null)" = multimodel ] || exit 0
. /media/data/plumos/bin/plumos-jz47xx-device-env

case "$PLUMOS_DEVICE_ID" in
    rg280v) kernel=RG280V ;;
    rg300x) kernel=RG300X ;;
    rg350) kernel=RG350 ;;
    rg350m) kernel=RG350M ;;
    *) exit 1 ;;
esac

saved=/boot/BOOTMOD.CFG
preference=$(printf '%-8sBIN' "$kernel")
# Keep the final newline in the comparison even inside command substitution.
if [ "$(cat "$saved" 2>/dev/null; printf '.')" = "$(printf '%s\n.' "$preference")" ]; then
    exit 0
fi

mount -o remount,rw /boot
pending=/boot/BOOTMOD.TMP
trap 'mount -o remount,ro /boot' EXIT
printf '%s\n' "$preference" >"$pending"
sync
mv -f "$pending" "$saved"
sync
