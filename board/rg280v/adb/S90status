#!/bin/sh

[ "$1" = start ] || exit 0
[ -x /media/data/local/bin/rg280v-fbshow ] || exit 0
[ -r /media/data/local/share/adb-ready.ppm ] || exit 0
[ "$(cat /sys/class/net/usb0/carrier 2>/dev/null)" = 1 ] || exit 0
pidof adbd >/dev/null 2>&1 || exit 0

echo 0 >/sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
/media/data/local/bin/rg280v-fbshow /media/data/local/share/adb-ready.ppm
